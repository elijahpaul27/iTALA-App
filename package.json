{
  "name": "itala",
  "version": "0.1.0",
  "description": "iTALA offline-first desktop application for Philippine K-12 educators.",
  "author": "iTALA",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite --host 127.0.0.1 --port 5174\" \"wait-on tcp:5174 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5174 electron .\"",
    "dev:web": "vite --host 127.0.0.1 --port 5174",
    "build": "vite build",
    "test": "vitest run",
    "pack": "npm run build && electron-builder --dir --win",
    "dist": "npm run build && electron-builder --win nsis",
    "dist:win": "npm run dist",
    "preview": "vite preview",
    "start": "electron ."
  },
  "build": {
    "appId": "com.itala.app",
    "productName": "iTALA",
    "npmRebuild": true,
    "buildDependenciesFromSource": false,
    "directories": {
      "output": "release-build"
    },
    "files": [
      "dist/**/*",
      "electron/main.js",
      "electron/preload.cjs",
      "electron/auditCore.js",
      "migrations/**/*",
      "src/db/schema.sql",
      "src/utils/exportService.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src/db/schema.sql",
        "to": "database/schema.sql"
      },
      {
        "from": "migrations",
        "to": "migrations",
        "filter": [
          "**/*.sql"
        ]
      },
      {
        "from": "templates",
        "to": "templates",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/sqlite3/**/*"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@tanstack/react-query": "^5.100.9",
    "@tanstack/react-virtual": "^3.13.24",
    "exceljs": "^4.4.0",
    "lodash.debounce": "^4.0.8",
    "lucide-react": "^1.14.0",
    "pdf-lib": "^1.17.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^3.8.1",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "vite": "^5.2.0",
    "vitest": "^4.1.5",
    "wait-on": "^7.2.0"
  }
}
